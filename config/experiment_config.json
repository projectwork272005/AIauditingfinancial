    "probe": {
      "replicate": 1,
      "note": "One call per distinct probe text (probe_text_id)."
    }
  },
  "generation": {
    "temperature": 0.7,
    "max_output_tokens": 2500,
    "json_mode": true,
    "timeout_s": 180,
